# Copy to server/.env and adjust
NODE_ENV=production
PORT=4000
# REQUIRED in production — long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12
# Set true when served over HTTPS
COOKIE_SECURE=false
# Storage locations (defaults: ./data and ./uploads at project root)
# DB_FILE=/var/lib/ozone-tracker/ozone-tracker.db
# UPLOAD_DIR=/var/lib/ozone-tracker/uploads
MAX_UPLOAD_MB=10
APP_TIMEZONE=Asia/Kolkata
# Show demo-account shortcuts on the login page (set false for production)
DEMO_MODE=true
# Phase 2 email notifications
# SMTP_HOST=smtp.office365.com
# SMTP_FROM=tickets@ozone.example
